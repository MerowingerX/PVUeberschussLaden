# Kopieren nach .env und Werte eintragen — .env bleibt lokal (gitignored)
PVUEB_INVERTER_IP=

# Optional: OCPP-Heartbeat der Wallbox in Sekunden (Default 10, im Web-UI änderbar)
#PVUEB_HEARTBEAT_S=10

# Optional: Nachttarif-Fenster (Tarif-Parameter), Format HH:MM.
# Fenster über Mitternacht erlaubt (z. B. 22:00 -> 06:00). Default 00:00-08:00.
#PVUEB_NIGHT_START=00:00
#PVUEB_NIGHT_END=08:00

# Standort (für Sonnenprognose via forecast.solar)
PVUEB_LAT=52.25
PVUEB_LON=10.66

# PV-Anlage: Leistung (kWp), Modulneigung (Grad), Ausrichtung
# (Azimut in forecast.solar-Konvention: 0 = Süd, -90 = Ost, 90 = West)
PVUEB_PV_KWP=7
PVUEB_PV_TILT=42
PVUEB_PV_AZIMUT=0

# Optional: Regelzeit-Parameter des Überschussladens (Sekunden).
# Poll-Takt, Mindestabstand zwischen Limit-Anpassungen, Verzögerung vor
# Ladestart bzw. Ladestopp bei vorhandenem/fehlendem Überschuss.
#PVUEB_POLL_INTERVAL_S=5
#PVUEB_ADJUST_MIN_INTERVAL_S=25
#PVUEB_START_DELAY_S=120
#PVUEB_STOP_DELAY_S=180

# Optional: minpv-Starttrigger und Wolkenloch-Überbrückung.
# Faktoren relativ zur Min-Leistung (min_amps × 3 × 230 V):
# Start erst ab START_FACTOR × Min echtem PV-Überschuss; fällt er unter
# PAUSE_FACTOR × Min, läuft ein Timeout von TIMEOUT_MIN Minuten; steigt er
# vorher über RESUME_FACTOR × Min, läuft die Ladung weiter, sonst Stopp.
# Bedingung: 0 < pause < resume <= start.
#PVUEB_MINPV_START_FACTOR=1.10
#PVUEB_MINPV_PAUSE_FACTOR=0.75
#PVUEB_MINPV_RESUME_FACTOR=0.90
#PVUEB_MINPV_TIMEOUT_MIN=10

# Optional: Höchstalter der von der Wallbox gemeldeten Ladeleistung. Der
# Überschuss wird als Netzleistung + Ladeleistung gerechnet — fehlt die
# Meldung (die Box kennt kein Power.Active.Import) oder ist sie älter als
# dieser Wert, wird die Ladeleistung aus dem gesetzten Limit geschätzt.
# Ohne das hielte der Regler die eigene Ladung für einen PV-Einbruch.
#PVUEB_CHARGE_W_MAX_AGE_S=30

# Optional: Abstand zwischen Startversuchen. Ob wirklich Strom fließt,
# entscheidet das Auto — es kann die Freigabe ignorieren (voll, Ladetimer).
# Nach jedem abgelehnten Versuch verdoppelt sich der Abstand bis 300 s.
# Meldet die Box SuspendedEV (Fahrzeug nimmt nichts an), wird sofort mit
# 300 s gewartet, statt im Regeltakt dagegenzuhalten.
#PVUEB_START_RETRY_S=30

# Optional: Regelbetrieb mitschreiben, eine JSON-Zeile je Abtastung und eine
# Datei pro Tag; ältere Tage werden gelöscht (Ringbuffer). Leer = aus.
# Rechnung: ~420 Byte je Zeile, bei 10 s also ~3,6 MB pro Tag.
# Im Container muss RECORD_DIR auf einem Volume liegen, sonst ist der
# Mitschnitt nach dem nächsten Update weg.
# Aus den Dateien macht poc/curve_from_recording.py PV-Kurven für test_sim.py.
#PVUEB_RECORD_DIR=/data/recordings
#PVUEB_RECORD_INTERVAL_S=10
#PVUEB_RECORD_KEEP_DAYS=14

# Optional: Auflösung des Ladelimits. OCPP überträgt Dezimalwerte, die Box
# setzt also auch Zwischenstufen um — feineres Raster heißt weniger
# verschenkter Überschuss. DEADBAND ist die Abweichung, ab der überhaupt neu
# gesetzt wird (verhindert Dauerfunk bei jedem Zehntel).
#PVUEB_LIMIT_STEP_A=0.1
#PVUEB_LIMIT_DEADBAND_A=0.3

# Optional: Mittelungsfenster des PV-Überschusses (Minuten). Die Ladeleistung
# folgt dem Mittelwert statt dem Momentanwert, gedeckelt auf das, was gerade
# wirklich da ist (PV + Batterie-Boost). START_AVG_MIN gilt, solange nicht
# geladen wird — kurz, damit der Start nicht dem trägen Mittel hinterherläuft.
# 0 = keine Glättung.
#PVUEB_AVG_WINDOW_MIN=10
#PVUEB_START_AVG_MIN=2

# Optional: Batterie-Boost — bei Wolkenlöchern schiebt die Hausbatterie
# Leistung ins Auto nach, statt die Ladung herunterzuregeln. Nur bei
# laufender Ladung, max BOOST_W, Tagesbudget = BOOST_W × BOOST_H (Reset um
# Mitternacht), Stopp unter BOOST_MIN_SOC. BOOST_H=0 schaltet den Boost aus.
#PVUEB_BOOST_W=2500
#PVUEB_BOOST_H=2
#PVUEB_BOOST_MIN_SOC=30

# Optional: Batterie-Netzladung im Nachtfenster
# Start unter LOW_SOC (%), Stopp ab TARGET_SOC (%), Ladeleistung (W),
# nur wenn Prognose für morgen unter FORECAST_MIN_KWH (kWh) liegt.
#PVUEB_BATT_LOW_SOC=30
#PVUEB_BATT_TARGET_SOC=80
#PVUEB_BATT_CHARGE_W=500
#PVUEB_FORECAST_MIN_KWH=5
