# Kopieren nach .env und Werte eintragen — .env bleibt lokal (gitignored)
PVUEB_INVERTER_IP=

# Optional: OCPP-Heartbeat der Wallbox in Sekunden (Default 10, im Web-UI änderbar)
#PVUEB_HEARTBEAT_S=10

# Optional: Nachttarif-Fenster (Tarif-Parameter), Format HH:MM.
# Fenster über Mitternacht erlaubt (z. B. 22:00 -> 06:00). Default 00:00-08:00.
#PVUEB_NIGHT_START=00:00
#PVUEB_NIGHT_END=08:00
